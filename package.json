{
  "name": "rescue-sketch",
  "version": "0.2.0",
  "private": true,
  "description": "Bilingual, open-source RoboCupJunior Rescue Line track sketching toolkit.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=11.9.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm validate:rulesets && pnpm test && pnpm build",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "validate:rulesets": "node scripts/validateRulesets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@supabase/supabase-js": "2.111.0",
    "@tanstack/react-query": "5.101.4",
    "@tarikjabiri/dxf": "2.8.9",
    "i18next": "26.3.6",
    "jspdf": "4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "svg2pdf.js": "2.7.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "globals": "17.8.0",
    "jsdom": "27.2.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
